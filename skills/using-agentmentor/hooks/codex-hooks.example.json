{
  "description": "AgentMentor completion and session recovery hooks for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-agentmentor-hook.cmd\" session-start",
            "commandWindows": "cmd /d /s /c \"\"%PLUGIN_ROOT%\\hooks\\run-agentmentor-hook.cmd\" session-start\"",
            "statusMessage": "Loading AgentMentor recovery context"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-agentmentor-hook.cmd\" pre-compact",
            "commandWindows": "cmd /d /s /c \"\"%PLUGIN_ROOT%\\hooks\\run-agentmentor-hook.cmd\" pre-compact\"",
            "statusMessage": "Saving AgentMentor recovery context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-agentmentor-hook.cmd\" stop",
            "commandWindows": "cmd /d /s /c \"\"%PLUGIN_ROOT%\\hooks\\run-agentmentor-hook.cmd\" stop\"",
            "statusMessage": "Checking AgentMentor closeout",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
